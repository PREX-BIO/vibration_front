{
  "name": "vibration",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:android": "expo run:android --device",
    "build:ios": "expo run:ios --device",
    "build:ios:unsigned": "bash scripts/build-ios-unsigned.sh",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test tests/*.test.cjs",
    "lint": "expo lint --no-cache",
    "lint:fix": "expo lint --fix --no-cache",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm test && npm run lint && npm run format:check",
    "doctor": "npx expo-doctor",
    "export": "expo export"
  },
  "dependencies": {
    "expo": "~58.0.26",
    "expo-constants": "~58.0.16",
    "expo-file-system": "~58.0.14",
    "expo-keep-awake": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-sensors": "~58.0.5",
    "expo-sharing": "~58.0.23",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~58.0.4",
    "prettier": "^3.8.3",
    "typescript": "~6.0.3"
  }
}
